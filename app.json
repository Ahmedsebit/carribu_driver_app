{
  "expo": {
    "name": "Carribu Driver",
    "slug": "carribudriver",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "sdkVersion": "55.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carribu.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.carribu.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBJmKq7c0Kh-CcseZYlBPLeqbfiqWZdYO4"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "deedde0b-7d63-4f67-a26f-be7d15a5c7b6"
      }
    },
    "plugins": [
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "Allow Carribu Driver to share your location during active school trips.",
        "locationWhenInUsePermission": "Allow Carribu Driver to use your location during active school trips.",
        "isAndroidBackgroundLocationEnabled": true,
        "isAndroidForegroundServiceEnabled": true,
        "isIosBackgroundLocationEnabled": true
      }],
      ["expo-notifications", {
        "color": "#16a34a"
      }]
    ],
    "owner": "firstbodis-organization"
  }
}
